# Copy this file to .env and fill in your key. .env is gitignored.
ANTHROPIC_API_KEY=
# Optional overrides:
# MODEL=claude-sonnet-4-6
# PORT=5173

# Microsoft Entra ID SSO (in-app MSAL — not Azure Easy Auth).
# Leave SSO_ENABLED=false for local development; the app behaves as before.
# Fill the Azure values only after IT registers the app; never commit secrets.
SSO_ENABLED=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=
# Optional SSO session limits (minutes):
# SSO_SESSION_IDLE_MINUTES=480
# SSO_SESSION_ABSOLUTE_MINUTES=1440
