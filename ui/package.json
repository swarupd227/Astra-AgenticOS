{
  "name": "astra-agenticos-ui",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "ASTRA AgenticOS — visual UI driving the SDLC agents against any project (local folder or git repo) via the same C# MCP server.",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "test": "npm run test:verify && npm run test:workspace && npm run test:evidence && npm run test:audit && npm run test:sources && npm run test:gaps && npm run test:review && npm run test:evalscore && npm run test:goldenscope && npm run test:sections && npm run test:guards && npm run test:perf && npm run test:drafts && npm run test:export && npm run test:coverage && npm run test:gate",
    "test:verify": "tsx test/verify.test.ts",
    "test:workspace": "tsx test/workspace.test.ts",
    "test:evidence": "tsx test/evidence.test.ts",
    "test:audit": "tsx test/audit.test.ts",
    "test:sources": "tsx test/source-checks.test.ts",
    "test:gaps": "tsx test/source-gaps.test.ts",
    "test:review": "tsx test/source-review.test.ts",
    "test:evalscore": "tsx test/eval-score.test.ts",
    "eval": "tsx eval/run.ts",
    "test:goldenscope": "tsx test/golden-scope.test.ts",
    "test:sections": "tsx test/sections.test.ts",
    "test:guards": "tsx test/guards.test.ts",
    "test:perf": "tsx test/perf.test.ts",
    "test:drafts": "tsx test/requirement-drafts.test.ts",
    "test:export": "tsx test/doc-export.test.ts",
    "test:coverage": "tsx test/source-coverage.test.ts",
    "test:gate": "tsx test/quality-gate.test.ts",
    "gate": "tsx src/quality-mcp.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.21.2",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/turndown": "^5.0.6",
    "playwright": "^1.61.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
