# Build output
bin/
obj/
*.user

# Node (UI)
node_modules/
npm-debug.log*
*.log

# Runtime state (UI projects, conversation history + cloned repos)
ui/projects.json
ui/threads.json
workspace/
# Golden Repository content belongs to the organisation running the platform,
# not to this repo — it lives on the persistent share in a real deployment.
ui/golden/

# Recorded demo videos (large binaries)
ui/recordings/

# Demo target codebase (cloned by scripts/setup.ps1) — external, reproducible
demo/nopCommerce/

# Generated agent outputs (reproducible by running the agents)
artifacts/*
!artifacts/.gitkeep

# Secrets — never commit
.env
*.env
!*.env.example
# Written by the in-app Settings panel; holds the API key. Lives in STATE_DIR,
# which is ui/ locally and the persistent share in a deployment.
ui/settings.json
settings.json

# Demo codebase (cloned via scripts/setup.ps1)
demo/nopCommerce/

# Generated artifacts (BRDs, ADRs, tests produced during the demo)
artifacts/*
!artifacts/.gitkeep

# IDE
.vs/
*.suo

ui/review-shots/
